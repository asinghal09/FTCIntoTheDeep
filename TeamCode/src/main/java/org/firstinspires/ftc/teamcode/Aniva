// Power level and timing values
double movePower = 0.5;  // Robot's speed
int timePerFoot = 1000;  // How long it takes to move 1 foot
int turnTime = 500;      // 90-degree turn

// Move straight
void moveStraight(double power, int time) throws InterruptedException {
    backLeft.setPower(power);
    frontLeft.setPower(power);
    backRight.setPower(power);
    frontRight.setPower(power);

    Thread.sleep(time);

    // Stop the motors after moving
    backLeft.setPower(0);
    frontLeft.setPower(0);
    backRight.setPower(0);
    frontRight.setPower(0);
}

// Turn 90 degrees CounterClockwise
void turn90DegreesCounterClockwise(double power, int time) throws InterruptedException {
    backLeft.setPower(-power);
    frontLeft.setPower(-power);
    backRight.setPower(power);
    frontRight.setPower(power);

    Thread.sleep(time);

    // Stop the motors after turning
    backLeft.setPower(0);
    frontLeft.setPower(0);
    backRight.setPower(0);
    frontRight.setPower(0);
}

// Main sequence
void mainSequence() throws InterruptedException {
    // Move straight for 1 foot
    moveStraight(movePower, timePerFoot);

    // Perform a 90-degree clockwise turn
    turn90DegreesClockwise(movePower, turnTime);

    // Move straight for 2 feet
    moveStraight(movePower, 2 * timePerFoot);
}
